{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoresearchclaw.org/schemas/research_state_v0.1.schema.json",
  "title": "AutoResearch Research State v0.1",
  "description": "Git-friendly, provenance-preserving state for one research project.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "migration",
    "project",
    "hypotheses",
    "claims",
    "evidence",
    "papers",
    "theorems",
    "lemmas",
    "experiments",
    "agent_runs",
    "decisions",
    "dependencies",
    "artifacts",
    "checkpoints",
    "tasks"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0", "type": "string"},
    "migration": {"$ref": "#/$defs/migration"},
    "project": {"$ref": "#/$defs/project"},
    "hypotheses": {"type": "array", "items": {"$ref": "#/$defs/hypothesis"}},
    "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "papers": {"type": "array", "items": {"$ref": "#/$defs/paper"}},
    "theorems": {"type": "array", "items": {"$ref": "#/$defs/theorem"}},
    "lemmas": {"type": "array", "items": {"$ref": "#/$defs/lemma"}},
    "experiments": {"type": "array", "items": {"$ref": "#/$defs/experiment"}},
    "agent_runs": {"type": "array", "items": {"$ref": "#/$defs/agentRun"}},
    "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}},
    "dependencies": {"type": "array", "items": {"$ref": "#/$defs/dependency"}},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "checkpoints": {"type": "array", "items": {"$ref": "#/$defs/checkpoint"}},
    "tasks": {"type": "array", "items": {"$ref": "#/$defs/task"}}
  },
  "$defs": {
    "timestamp": {"type": "string", "format": "date-time"},
    "nullableTimestamp": {"type": ["string", "null"], "format": "date-time"},
    "id": {
      "type": "string",
      "pattern": "^(proj|hyp|claim|ev|paper|thm|lem|exp|run|dec|dep|art|chk|task)_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "projId": {"type": "string", "pattern": "^proj_[0-9A-HJKMNP-TV-Z]{26}$"},
    "hypId": {"type": "string", "pattern": "^hyp_[0-9A-HJKMNP-TV-Z]{26}$"},
    "claimId": {"type": "string", "pattern": "^claim_[0-9A-HJKMNP-TV-Z]{26}$"},
    "evId": {"type": "string", "pattern": "^ev_[0-9A-HJKMNP-TV-Z]{26}$"},
    "paperId": {"type": "string", "pattern": "^paper_[0-9A-HJKMNP-TV-Z]{26}$"},
    "thmId": {"type": "string", "pattern": "^thm_[0-9A-HJKMNP-TV-Z]{26}$"},
    "lemId": {"type": "string", "pattern": "^lem_[0-9A-HJKMNP-TV-Z]{26}$"},
    "expId": {"type": "string", "pattern": "^exp_[0-9A-HJKMNP-TV-Z]{26}$"},
    "runId": {"type": "string", "pattern": "^run_[0-9A-HJKMNP-TV-Z]{26}$"},
    "decId": {"type": "string", "pattern": "^dec_[0-9A-HJKMNP-TV-Z]{26}$"},
    "depId": {"type": "string", "pattern": "^dep_[0-9A-HJKMNP-TV-Z]{26}$"},
    "artId": {"type": "string", "pattern": "^art_[0-9A-HJKMNP-TV-Z]{26}$"},
    "chkId": {"type": "string", "pattern": "^chk_[0-9A-HJKMNP-TV-Z]{26}$"},
    "taskId": {"type": "string", "pattern": "^task_[0-9A-HJKMNP-TV-Z]{26}$"},
    "stringList": {"type": "array", "items": {"type": "string"}},
    "idList": {"type": "array", "items": {"$ref": "#/$defs/id"}},
    "humanVerification": {
      "type": "string",
      "enum": ["UNREVIEWED", "PARTIALLY_REVIEWED", "VERIFIED", "REJECTED"]
    },
    "decisionMetrics": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "description": "Heuristic metadata only; never an automatic GO/KILL rule.",
      "properties": {
        "novelty": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "theorem_feasibility": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "empirical_support": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "collision_risk": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "technical_risk": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "estimated_cost": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "expected_information_gain": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "notes": {"type": ["string", "null"]}
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_version", "target_version", "migrated_at", "migration_id", "notes"],
      "properties": {
        "source_version": {"type": ["string", "null"]},
        "target_version": {"const": "0.1.0", "type": "string"},
        "migrated_at": {"$ref": "#/$defs/timestamp"},
        "migration_id": {"type": "string", "minLength": 1},
        "notes": {"type": ["string", "null"]}
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "short_name", "description", "created_at", "updated_at",
        "status", "research_domain", "owners", "advisors", "repository",
        "current_decision", "current_research_decision", "current_research_verdict",
        "current_phase", "priority", "tags", "dependencies", "active_hypotheses",
        "next_action", "resume_point", "frozen_at", "archived_at"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/projId"},
        "title": {"type": "string", "minLength": 1},
        "short_name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "created_at": {"$ref": "#/$defs/timestamp"},
        "updated_at": {"$ref": "#/$defs/timestamp"},
        "status": {"type": "string", "enum": ["IDEA", "AUDITING", "RUNNING", "BLOCKED", "FROZEN", "PAPER_WRITING", "SUBMITTED", "ACCEPTED", "REJECTED", "KILLED", "ARCHIVED"]},
        "research_domain": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "owners": {"$ref": "#/$defs/stringList"},
        "advisors": {"$ref": "#/$defs/stringList"},
        "repository": {"type": ["string", "null"]},
        "current_decision": {"type": ["string", "null"], "pattern": "^dec_[0-9A-HJKMNP-TV-Z]{26}$"},
        "current_research_decision": {"type": ["string", "null"], "pattern": "^dec_[0-9A-HJKMNP-TV-Z]{26}$"},
        "current_research_verdict": {"type": "string", "enum": ["GO", "RESTRICTED_GO", "KILL", "UNKNOWN"]},
        "current_phase": {"type": "string", "minLength": 1},
        "priority": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
        "tags": {"$ref": "#/$defs/stringList"},
        "dependencies": {"type": "array", "items": {"$ref": "#/$defs/depId"}},
        "active_hypotheses": {"type": "array", "items": {"$ref": "#/$defs/hypId"}},
        "next_action": {"type": ["string", "null"], "pattern": "^task_[0-9A-HJKMNP-TV-Z]{26}$"},
        "resume_point": {"type": ["string", "null"]},
        "frozen_at": {"$ref": "#/$defs/nullableTimestamp"},
        "archived_at": {"$ref": "#/$defs/nullableTimestamp"},
        "decision_metrics": {"$ref": "#/$defs/decisionMetrics"}
      }
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "project_id", "statement", "formal_statement", "status", "parent_hypothesis", "children", "assumptions", "supporting_claims", "attacking_claims", "created_by", "created_at", "last_updated", "confidence", "kill_reason", "human_verification"],
      "properties": {
        "id": {"$ref": "#/$defs/hypId"},
        "project_id": {"$ref": "#/$defs/projId"},
        "statement": {"type": "string", "minLength": 1},
        "formal_statement": {"type": ["string", "null"]},
        "status": {"type": "string", "enum": ["PROPOSED", "UNDER_TEST", "SUPPORTED", "RESTRICTED", "REFUTED", "SUPERSEDED", "FROZEN"]},
        "parent_hypothesis": {"type": ["string", "null"], "pattern": "^hyp_[0-9A-HJKMNP-TV-Z]{26}$"},
        "children": {"type": "array", "items": {"$ref": "#/$defs/hypId"}},
        "assumptions": {"$ref": "#/$defs/stringList"},
        "supporting_claims": {"type": "array", "items": {"$ref": "#/$defs/claimId"}},
        "attacking_claims": {"type": "array", "items": {"$ref": "#/$defs/claimId"}},
        "created_by": {"type": "string", "minLength": 1},
        "agent_run_id": {"type": ["string", "null"], "pattern": "^run_[0-9A-HJKMNP-TV-Z]{26}$"},
        "created_at": {"$ref": "#/$defs/timestamp"},
        "last_updated": {"$ref": "#/$defs/timestamp"},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "kill_reason": {"type": ["string", "null"]},
        "human_verification": {"$ref": "#/$defs/humanVerification"}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "project_id", "statement", "claim_type", "scope", "status", "confidence", "supporting_evidence", "opposing_evidence", "dependencies", "source", "created_by", "reviewed_by", "created_at", "last_verified_at", "human_verification"],
      "properties": {
        "id": {"$ref": "#/$defs/claimId"},
        "project_id": {"$ref": "#/$defs/projId"},
        "statement": {"type": "string", "minLength": 1},
        "claim_type": {"type": "string", "enum": ["THEORETICAL", "EMPIRICAL", "NOVELTY", "LITERATURE", "ENGINEERING", "ASSUMPTION", "INTERPRETATION"]},
        "scope": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["PROPOSED", "ACTIVE", "SUPPORTED", "RESTRICTED", "REFUTED", "SUPERSEDED", "FROZEN", "UNVERIFIED"]},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "supporting_evidence": {"type": "array", "items": {"$ref": "#/$defs/evId"}},
        "opposing_evidence": {"type": "array", "items": {"$ref": "#/$defs/evId"}},
        "dependencies": {"type": "array", "items": {"$ref": "#/$defs/depId"}},
        "source": {"$ref": "#/$defs/idList"},
        "created_by": {"type": "string", "minLength": 1},
        "agent_run_id": {"type": ["string", "null"], "pattern": "^run_[0-9A-HJKMNP-TV-Z]{26}$"},
        "reviewed_by": {"$ref": "#/$defs/stringList"},
        "created_at": {"$ref": "#/$defs/timestamp"},
        "last_verified_at": {"$ref": "#/$defs/nullableTimestamp"},
        "human_verification": {"$ref": "#/$defs/humanVerification"},
        "notes": {"type": ["string", "null"]}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "project_id", "type", "title", "summary", "supports", "opposes", "strength", "source_uri", "artifact_id", "paper_id", "experiment_id", "theorem_id", "agent_run_id", "human_source", "timestamp", "verified", "verification_status", "human_verification", "notes"],
      "properties": {
        "id": {"$ref": "#/$defs/evId"},
        "project_id": {"$ref": "#/$defs/projId"},
        "type": {"type": "string", "enum": ["PAPER", "THEOREM", "EXPERIMENT", "COUNTEREXAMPLE", "SIMULATION", "BENCHMARK", "MATHEMATICAL_DERIVATION", "CODE_RESULT", "HUMAN_EXPERT_FEEDBACK"]},
        "title": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "supports": {"type": "array", "items": {"$ref": "#/$defs/claimId"}},
        "opposes": {"type": "array", "items": {"$ref": "#/$defs/claimId"}},
        "strength": {"type": "string", "enum": ["WEAK", "MODERATE", "STRONG", "DECISIVE", "UNKNOWN"]},
        "source_uri": {"type": ["string", "null"]},
        "artifact_id": {"type": ["string", "null"], "pattern": "^art_[0-9A-HJKMNP-TV-Z]{26}$"},
        "paper_id": {"type": ["string", "null"], "pattern": "^paper_[0-9A-HJKMNP-TV-Z]{26}$"},
        "experiment_id": {"type": ["string", "null"], "pattern": "^exp_[0-9A-HJKMNP-TV-Z]{26}$"},
        "theorem_id": {"type": ["string", "null"], "pattern": "^thm_[0-9A-HJKMNP-TV-Z]{26}$"},
        "agent_run_id": {"type": ["string", "null"], "pattern": "^run_[0-9A-HJKMNP-TV-Z]{26}$"},
        "human_source": {"type": ["string", "null"]},
        "timestamp": {"$ref": "#/$defs/timestamp"},
        "verified": {"type": "boolean"},
        "verification_status": {"$ref": "#/$defs/humanVerification"},
        "human_verification": {"$ref": "#/$defs/humanVerification"},
        "notes": {"type": ["string", "null"]}
      }
    },
    "paper": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "project_id", "title", "authors", "year", "venue", "doi", "arxiv", "url", "pdf_path", "status", "reading_priority", "relevance_score", "collision_risk", "research_cluster", "key_contributions", "main_theorems", "exact_overlap", "limitations_relative_to_project", "cited_by_project_claims", "verified", "verification_status", "last_checked_at", "artifact_id"],
      "properties": {
        "id": {"$ref": "#/$defs/paperId"},
        "project_id": {"$ref": "#/$defs/projId"},
        "title": {"type": "string", "minLength": 1},
        "authors": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "year": {"type": ["integer", "null"], "minimum": 1800},
        "venue": {"type": ["string", "null"]},
        "doi": {"type": ["string", "null"]},
        "arxiv": {"type": ["string", "null"]},
        "url": {"type": ["string", "null"]},
        "pdf_path": {"type": ["string", "null"]},
        "status": {"type": "string", "enum": ["IDENTIFIED", "SCREENED", "VERIFIED", "EXCLUDED", "RETRACTED", "UNVERIFIED"]},
        "reading_priority": {"type": "string", "enum": ["MUST_READ", "SHOULD_READ", "BACKGROUND", "NOVELTY_THREAT"]},
        "relevance_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "collision_risk": {"type": "string", "enum": ["NONE", "LOW", "MEDIUM", "HIGH", "CRITICAL", "UNKNOWN"]},
        "research_cluster": {"type": "string", "minLength": 1},
        "key_contributions": {"$ref": "#/$defs/stringList"},
        "main_theorems": {"$ref": "#/$defs/stringList"},
        "exact_overlap": {"type": "string"},
        "limitations_relative_to_project": {"type": "string"},
        "cited_by_project_claims": {"type": "array", "items": {"$ref": "#/$defs/claimId"}},
        "verified": {"type": "boolean"},
        "verification_status": {"$ref": "#/$defs/humanVerification"},
        "last_checked_at": {"$ref": "#/$defs/nullableTimestamp"},
        "artifact_id": {"type": ["string", "null"], "pattern": "^art_[0-9A-HJKMNP-TV-Z]{26}$"}
      }
    },
    "theorem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "project_id", "title", "statement", "formal_statement", "status", "assumptions", "dependencies", "required_lemmas", "proof_attempts", "counterexample_attempts", "known_gaps", "references", "supporting_claims", "confidence", "review_status", "human_verified", "human_verification", "created_at", "updated_at"],
      "properties": {
        "id": {"$ref": "#/$defs/thmId"},
        "project_id": {"$ref": "#/$defs/projId"},
        "title": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "formal_statement": {"type": ["string", "null"]},
        "status": {"type": "string", "enum": ["CONJECTURED", "FORMALIZED", "PROOF_SEARCH", "PARTIAL_PROOF", "PROVED_BY_AGENT", "COUNTEREXAMPLE_FOUND", "REFUTED", "HUMAN_VERIFIED", "SUBMITTED"]},
        "assumptions": {"$ref": "#/$defs/stringList"},
        "dependencies": {"type": "array", "items": {"$ref": "#/$defs/depId"}},
        "required_lemmas": {"type": "array", "items": {"$ref": "#/$defs/lemId"}},
        "proof_attempts": {"type": "array", "items": {"$ref": "#/$defs/runId"}},
        "counterexample_attempts": {"type": "array", "items": {"$ref": "#/$defs/runId"}},
        "known_gaps": {"$ref": "#/$defs/stringList"},
        "references": {"type": "array", "items": {"$ref": "#/$defs/paperId"}},
        "supporting_claims": {"type": "array", "items": {"$ref": "#/$defs/claimId"}},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "review_status": {"type": "string", "enum": ["UNREVIEWED", "AGENT_REVIEWED", "HUMAN_REVIEW_PENDING", "HUMAN_REVIEWED", "REJECTED"]},
        "human_verified": {"type": "boolean"},
        "human_verification": {"$ref": "#/$defs/humanVerification"},
        "created_at": {"$ref": "#/$defs/timestamp"},
        "updated_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "lemma": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "project_id", "title", "statement", "status", "parent_theorems", "dependencies", "proof_attempts", "references", "counterexamples", "notes", "human_verification"],
      "properties": {
        "id": {"$ref": "#/$defs/lemId"},
        "project_id": {"$ref": "#/$defs/projId"},
        "title": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["CONJECTURED", "FORMALIZED", "PROOF_SEARCH", "PARTIAL_PROOF", "PROVED_BY_AGENT", "COUNTEREXAMPLE_FOUND", "REFUTED", "HUMAN_VERIFIED"]},
        "parent_theorems": {"type": "array", "items": {"$ref": "#/$defs/thmId"}},
        "dependencies": {"$ref": "#/$defs/idList"},
        "proof_attempts": {"type": "array", "items": {"$ref": "#/$defs/runId"}},
        "references": {"type": "array", "items": {"$ref": "#/$defs/paperId"}},
        "counterexamples": {"type": "array", "items": {"$ref": "#/$defs/evId"}},
        "notes": {"type": ["string", "null"]},
        "human_verification": {"$ref": "#/$defs/humanVerification"}
      }
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "project_id", "title", "goal", "hypothesis_ids", "config", "dataset", "code_ref", "status", "started_at", "finished_at", "compute", "metrics", "results", "artifacts", "result_evidence", "interpretation", "failure_reason", "reproducible", "seed", "environment", "agent_run_id"],
      "properties": {
        "id": {"$ref": "#/$defs/expId"},
        "project_id": {"$ref": "#/$defs/projId"},
        "title": {"type": "string", "minLength": 1},
        "goal": {"type": "string", "minLength": 1},
        "hypothesis_ids": {"type": "array", "items": {"$ref": "#/$defs/hypId"}},
        "config": {"type": "object"},
        "dataset": {},
        "code_ref": {"type": ["string", "null"]},
        "status": {"type": "string", "enum": ["PLANNED", "RUNNING", "PASSED", "FAILED", "INCONCLUSIVE", "ABORTED"]},
        "started_at": {"$ref": "#/$defs/nullableTimestamp"},
        "finished_at": {"$ref": "#/$defs/nullableTimestamp"},
        "compute": {"type": "object"},
        "metrics": {"type": "object"},
        "results": {"type": "object"},
        "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artId"}},
        "result_evidence": {"type": "array", "items": {"$ref": "#/$defs/evId"}},
        "interpretation": {"type": ["string", "null"]},
        "failure_reason": {"type": ["string", "null"]},
        "reproducible": {"type": "boolean"},
        "seed": {"type": ["integer", "string", "null"]},
        "environment": {"type": "object"},
        "agent_run_id": {"type": ["string", "null"], "pattern": "^run_[0-9A-HJKMNP-TV-Z]{26}$"}
      }
    },
    "agentRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "project_id", "agent_role", "model", "prompt_ref", "started_at", "finished_at", "duration_seconds", "task", "inputs", "outputs", "artifacts", "claims_created", "claims_modified", "decisions_proposed", "errors", "compute", "tokens", "cost", "status"],
      "properties": {
        "id": {"$ref": "#/$defs/runId"},
        "project_id": {"$ref": "#/$defs/projId"},
        "agent_role": {"type": "string", "enum": ["GENERAL_RESEARCH", "LITERATURE_SEARCH", "PROOF", "COUNTEREXAMPLE", "REFEREE", "ASSUMPTION_MINIMIZER", "EXPERIMENT", "CODER", "FORMALIZER", "SYNTHESIS"]},
        "model": {"type": ["string", "null"]},
        "prompt_ref": {"type": ["string", "null"]},
        "started_at": {"$ref": "#/$defs/nullableTimestamp"},
        "finished_at": {"$ref": "#/$defs/nullableTimestamp"},
        "duration_seconds": {"type": ["number", "null"], "minimum": 0},
        "task": {"type": "string", "minLength": 1},
        "inputs": {"$ref": "#/$defs/idList"},
        "outputs": {"$ref": "#/$defs/idList"},
        "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artId"}},
        "claims_created": {"type": "array", "items": {"$ref": "#/$defs/claimId"}},
        "claims_modified": {"type": "array", "items": {"$ref": "#/$defs/claimId"}},
        "decisions_proposed": {"type": "array", "items": {"$ref": "#/$defs/decId"}},
        "errors": {"$ref": "#/$defs/stringList"},
        "compute": {"type": "object"},
        "tokens": {"type": ["integer", "null"], "minimum": 0},
        "cost": {"type": ["number", "null"], "minimum": 0},
        "status": {"type": "string", "enum": ["PLANNED", "RUNNING", "COMPLETED", "FAILED", "ABORTED", "BLOCKED"]}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "project_id", "decision_type", "scope", "target_id", "reasoning_summary", "supporting_evidence", "opposing_evidence", "confidence", "decided_by", "agent_run_id", "timestamp", "supersedes", "next_action", "decision_metrics", "human_verification"],
      "properties": {
        "id": {"$ref": "#/$defs/decId"},
        "project_id": {"$ref": "#/$defs/projId"},
        "decision_type": {"type": "string", "enum": ["GO", "RESTRICTED_GO", "KILL", "FREEZE", "RESUME", "BLOCK", "UNBLOCK", "PRIORITIZE", "DEPRIORITIZE"]},
        "scope": {"type": "string", "enum": ["PROJECT", "HYPOTHESIS", "CLAIM", "THEOREM", "EXPERIMENT", "TASK"]},
        "target_id": {"$ref": "#/$defs/id"},
        "reasoning_summary": {"type": "string", "minLength": 1},
        "supporting_evidence": {"type": "array", "items": {"$ref": "#/$defs/evId"}},
        "opposing_evidence": {"type": "array", "items": {"$ref": "#/$defs/evId"}},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "decided_by": {"type": "string", "minLength": 1},
        "agent_run_id": {"type": ["string", "null"], "pattern": "^run_[0-9A-HJKMNP-TV-Z]{26}$"},
        "timestamp": {"$ref": "#/$defs/timestamp"},
        "supersedes": {"type": ["string", "null"], "pattern": "^dec_[0-9A-HJKMNP-TV-Z]{26}$"},
        "next_action": {"type": ["string", "null"], "pattern": "^task_[0-9A-HJKMNP-TV-Z]{26}$"},
        "decision_metrics": {"$ref": "#/$defs/decisionMetrics"},
        "human_verification": {"$ref": "#/$defs/humanVerification"}
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "target", "dependency_type", "status", "description", "created_at", "resolved_at"],
      "properties": {
        "id": {"$ref": "#/$defs/depId"},
        "source": {"$ref": "#/$defs/id"},
        "target": {"$ref": "#/$defs/id"},
        "dependency_type": {"type": "string", "enum": ["REQUIRES", "BLOCKS", "SUPPORTS", "CONTRADICTS", "EXTENDS", "SUPERSEDES", "DERIVED_FROM"]},
        "status": {"type": "string", "enum": ["ACTIVE", "SATISFIED", "BLOCKED", "WAIVED", "INVALIDATED"]},
        "description": {"type": "string", "minLength": 1},
        "created_at": {"$ref": "#/$defs/timestamp"},
        "resolved_at": {"$ref": "#/$defs/nullableTimestamp"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "path", "title", "description", "created_by", "agent_run_id", "created_at", "sha256", "project_id", "related_objects", "is_primary", "version"],
      "properties": {
        "id": {"$ref": "#/$defs/artId"},
        "type": {"type": "string", "enum": ["MARKDOWN", "YAML", "JSON", "CSV", "FIGURE", "CODE", "NOTEBOOK", "DATASET", "THEOREM_PROOF", "PDF", "REPORT", "CHECKPOINT", "OTHER"]},
        "path": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "created_by": {"type": "string", "minLength": 1},
        "agent_run_id": {"type": ["string", "null"], "pattern": "^run_[0-9A-HJKMNP-TV-Z]{26}$"},
        "created_at": {"$ref": "#/$defs/timestamp"},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "project_id": {"$ref": "#/$defs/projId"},
        "related_objects": {"$ref": "#/$defs/idList"},
        "is_primary": {"type": "boolean"},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "project_id", "timestamp", "reason", "status_snapshot", "current_decision", "active_hypotheses", "blocking_dependencies", "next_action", "resume_instructions", "git_commit", "artifacts"],
      "properties": {
        "id": {"$ref": "#/$defs/chkId"},
        "project_id": {"$ref": "#/$defs/projId"},
        "timestamp": {"$ref": "#/$defs/timestamp"},
        "reason": {"type": "string", "minLength": 1},
        "status_snapshot": {"type": "object"},
        "current_decision": {"type": ["string", "null"], "pattern": "^dec_[0-9A-HJKMNP-TV-Z]{26}$"},
        "active_hypotheses": {"type": "array", "items": {"$ref": "#/$defs/hypId"}},
        "blocking_dependencies": {"type": "array", "items": {"$ref": "#/$defs/depId"}},
        "next_action": {"type": ["string", "null"], "pattern": "^task_[0-9A-HJKMNP-TV-Z]{26}$"},
        "resume_instructions": {"type": "string", "minLength": 1},
        "git_commit": {"type": ["string", "null"]},
        "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artId"}}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "project_id", "title", "description", "priority", "status", "target_id", "depends_on", "estimated_cost", "expected_information_gain", "assigned_agent", "agent_run_id", "created_at", "due", "result"],
      "properties": {
        "id": {"$ref": "#/$defs/taskId"},
        "project_id": {"$ref": "#/$defs/projId"},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "priority": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
        "status": {"type": "string", "enum": ["TODO", "READY", "BLOCKED", "IN_PROGRESS", "DONE", "CANCELLED"]},
        "target_id": {"type": ["string", "null"], "pattern": "^(proj|hyp|claim|thm|lem|exp|paper|dep)_[0-9A-HJKMNP-TV-Z]{26}$"},
        "depends_on": {"$ref": "#/$defs/idList"},
        "estimated_cost": {"type": "object"},
        "expected_information_gain": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "assigned_agent": {"type": ["string", "null"]},
        "agent_run_id": {"type": ["string", "null"], "pattern": "^run_[0-9A-HJKMNP-TV-Z]{26}$"},
        "created_at": {"$ref": "#/$defs/timestamp"},
        "due": {"$ref": "#/$defs/nullableTimestamp"},
        "result": {"$ref": "#/$defs/idList"}
      }
    }
  }
}
